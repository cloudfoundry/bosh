set -e

mkdir -p ${BOSH_INSTALL_TARGET}/bin

# Select the blob matching the compile VM's architecture.
case "$(uname -m)" in
  x86_64)        arch="amd64" ;;
  aarch64|arm64) arch="arm64" ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

mv s3cli/s3cli-*-linux-${arch} ${BOSH_INSTALL_TARGET}/bin/s3cli
chmod +x ${BOSH_INSTALL_TARGET}/bin/s3cli
