set -e

mkdir -p "${BOSH_INSTALL_TARGET}"/{bin,gem_home}

source /var/vcap/packages/director-ruby-4.0/bosh/compile.env

# Select the blob matching the compile VM's architecture.
case "$(uname -m)" in
  x86_64)        nats_arch="amd64" ;;
  aarch64|arm64) nats_arch="arm64" ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac
tar xzf nats/nats-server-v*-linux-${nats_arch}.tar.gz
cp nats-server-v*-linux-${nats_arch}/nats-server "${BOSH_INSTALL_TARGET}/bin/nats-server"
chmod +x "${BOSH_INSTALL_TARGET}/bin/nats-server"

working_dir="$(pwd)"
for gemspec in ./bosh-*/*.gemspec; do
  pushd "$(dirname "${gemspec}")"
    gem build
    mv ./*.gem "${working_dir}/vendor/cache/"
  popd
done

cat > Gemfile <<EOF
gem 'bosh-nats-sync'
EOF

bosh_bundle_local
bosh_generate_runtime_env

cp -r Gemfile Gemfile.lock .bundle "${BOSH_INSTALL_TARGET}"
