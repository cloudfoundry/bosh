set -e

go_compile_env="${BOSH_PACKAGES_DIR:-/var/vcap/packages}/golang-1-linux/bosh/compile.env"
if [ -f "$go_compile_env" ]; then
  # shellcheck disable=SC1091
  source "$go_compile_env"
fi

if ! command -v go >/dev/null 2>&1; then
  echo "ERROR: Go toolchain not found." >&2
  echo "  Add golang-1-linux as a dependency in packages/health_monitor/spec" >&2
  echo "  or ensure 'go' is available on PATH." >&2
  exit 1
fi

echo "Using $(go version)"
mkdir -p "${BOSH_INSTALL_TARGET}/bin"

cd bosh-monitor

# BOSH compilation VMs have no network access, so dependencies must come from
# the committed vendor/ directory rather than the module proxy.
export GOFLAGS="-mod=vendor"
export GOPROXY=off

go build -o "${BOSH_INSTALL_TARGET}/bin/bosh-monitor" .

for plugin_dir in cmd/plugins/hm-*; do
  plugin_name="$(basename "${plugin_dir}")"
  go build -o "${BOSH_INSTALL_TARGET}/bin/${plugin_name}" "./${plugin_dir}"
done
